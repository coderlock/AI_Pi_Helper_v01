{
  "name": "pi-assistant",
  "version": "0.1.0",
  "description": "AI-powered Raspberry Pi SSH management tool",
  "main": "dist/main/main.js",
  "author": "Your Name",
  "license": "MIT",
  "scripts": {
    "build": "tsc && webpack",
    "build:main": "tsc",
    "build:renderer": "webpack",
    "watch": "concurrently -k \"tsc -w\" \"webpack --watch\"",
    "start": "npm run build && electron .",
    "dev": "concurrently -k \"npm run watch\" \"npx wait-on dist/main/main.js dist/renderer/renderer.bundle.js && electron .\"",
    "rebuild": "electron-rebuild",
    "dist": "npm run build && electron-builder",
    "clean": "rimraf dist release"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/ssh2": "^1.15.5",
    "@types/uuid": "^10.0.0",
    "concurrently": "^8.2.2",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^7.1.3",
    "electron": "^40.2.1",
    "electron-builder": "^26.7.0",
    "rimraf": "^5.0.5",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.3.3",
    "wait-on": "^7.2.0",
    "webpack": "^5.105.0",
    "webpack-cli": "^6.0.1"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "node-pty": "^1.1.0",
    "ssh2": "^1.17.0",
    "uuid": "^13.0.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  }
}
